# Cole essas variáveis na tela "Environment variables" do Portainer ao criar a Stack

# Senha do PostgreSQL (crie uma senha forte)
POSTGRES_PASSWORD=SuaSenhaForteAqui

# URL pública do dashboard (ex: https://dashboard.suaempresa.com ou http://IP_DA_VPS:3000)
BETTER_AUTH_URL=http://SEU_IP_OU_DOMINIO:3000

# Secret para JWT do better-auth — gere com: openssl rand -hex 32
BETTER_AUTH_SECRET=cole_aqui_o_resultado_do_openssl
