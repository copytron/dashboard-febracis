# Banco de dados — Postgres_Febracis na VPS
DATABASE_URL="postgresql://Postgres_Febracis:<SENHA_POSTGRES>@localhost:5432/Postgres_Febracis"

# better-auth — gere um secret aleatório: openssl rand -hex 32
BETTER_AUTH_SECRET="<SECRET_ALEATORIO_32_BYTES>"
BETTER_AUTH_URL="http://localhost:3000"

# Windsor.ai (opcional — para sync de dados)
WINDSOR_API_KEY="<SUA_WINDSOR_API_KEY>"
